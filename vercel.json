{
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp.js" },
    { "source": "/api/mcp", "destination": "/api/mcp.js" },
    { "source": "/api/v1/:path*", "destination": "/api/v1.js" },
    { "source": "/enquiry", "destination": "/index.html" },
    { "source": "/farm", "destination": "/farm.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/product", "destination": "/product.html" }
  ]
}
